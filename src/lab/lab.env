# HappyLab lab topology: single source of names, addresses and baseline values.
# Plain KEY=value lines only (no quotes, no expansions), so both bash and Python can read it.
# Addresses are documentation prefixes (RFC 5737, RFC 3849); they never leave the namespaces.

NS_CLIENT=hl-client
NS_SERVER=hl-server

# v4 link: IPv4 only, impaired by scenarios
V4_IF_C=hl-v4c
V4_IF_S=hl-v4s
V4_ADDR_C=192.0.2.1
V4_ADDR_S=192.0.2.2
V4_PREFIX_LEN=24
V4_MAC_C=02:68:6c:04:00:01
V4_MAC_S=02:68:6c:04:00:02

# v6 link: IPv6 only, impaired by scenarios
V6_IF_C=hl-v6c
V6_IF_S=hl-v6s
V6_ADDR_C=2001:db8:28:6::1
V6_ADDR_S=2001:db8:28:6::2
V6_PREFIX_LEN=64
V6_MAC_C=02:68:6c:06:00:01
V6_MAC_S=02:68:6c:06:00:02

# ctl link: IPv4 only, carries DNS, never impaired
CTL_IF_C=hl-ctlc
CTL_IF_S=hl-ctls
CTL_ADDR_C=198.51.100.1
CTL_ADDR_S=198.51.100.53
CTL_PREFIX_LEN=24
CTL_MAC_C=02:68:6c:0c:00:01
CTL_MAC_S=02:68:6c:0c:00:02

DNS_ADDR=198.51.100.53

# Impairments live on the server side only, so the client interfaces (the capture point)
# carry no qdisc. Server->client: netem on the server end. Client->server: the server
# end's ingress is redirected to these ifb devices (inside hl-server), which carry netem.
V4_IFB=hl-ifb4
V6_IFB=hl-ifb6

# Baseline: 10 ms each way on both ends of the v4 and v6 links, so 20 ms RTT.
BASELINE_DELAY_MS=10
BASELINE_RTT_MS=20
# The ctl link must stay below this RTT (unimpaired).
CTL_MAX_RTT_MS=2

# RTT measurement in verify.sh
PING_COUNT=10
PING_INTERVAL_S=0.2
PING_WAIT_S=2

# Lab-only resolver and address-selection files, bind-mounted by `ip netns exec` in hl-client only.
NETNS_ETC=/etc/netns/hl-client
